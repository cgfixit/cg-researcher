{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "cargo-audit",
     "version": "0.22.2",
     "informationUri": "https://github.com/rustsec/rustsec",
     "rules": []
    }
   },
   "results": []
  },
  {
   "tool": {
    "driver": {
     "name": "osv-scanner",
     "version": "2.7.0",
     "informationUri": "https://github.com/google/osv-scanner",
     "rules": []
    }
   },
   "results": []
  },
  {
   "tool": {
    "driver": {
     "name": "cg-researcher-manual-review",
     "version": "1",
     "informationUri": "https://github.com/cgfixit/cg-researcher",
     "rules": [
      {
       "id": "CG-ACC-001",
       "shortDescription": {
        "text": "Accepted risk: audit key holder can truncate and re-sign the head"
       },
       "fullDescription": {
        "text": "A signed head (audit.pb.head) detects whole-record tail deletion by anyone without audit.key. A same-user attacker holding the key can forge it; mitigation is an off-host anchor of `audit tail -n 1`."
       },
       "defaultConfiguration": {
        "level": "note"
       }
      },
      {
       "id": "CG-ACC-003",
       "shortDescription": {
        "text": "Accepted risk: duplicate transitive crate versions"
       },
       "fullDescription": {
        "text": "foldhash x2, hashbrown x3, syn x2. No advisories; binary size and build time only."
       },
       "defaultConfiguration": {
        "level": "note"
       }
      },
      {
       "id": "CG-ACC-005",
       "shortDescription": {
        "text": "Accepted risk: local cargo-audit binary had no published checksum"
       },
       "fullDescription": {
        "text": "Local scan only. CI builds cargo-audit from crates.io with --locked."
       },
       "defaultConfiguration": {
        "level": "note"
       }
      },
      {
       "id": "CG-ACC-006",
       "shortDescription": {
        "text": "Accepted risk: ad-hoc signing causes Keychain re-prompts after rebuilds"
       },
       "fullDescription": {
        "text": "No Developer ID / notarization; a nuisance, not a bypass."
       },
       "defaultConfiguration": {
        "level": "note"
       }
      },
      {
       "id": "CG-ACC-007",
       "shortDescription": {
        "text": "Accepted risk: external-call budget is in-memory"
       },
       "fullDescription": {
        "text": "Resets on restart; restarting needs local access; provider spend limits are the backstop."
       },
       "defaultConfiguration": {
        "level": "note"
       }
      },
      {
       "id": "CG-ACC-008",
       "shortDescription": {
        "text": "Accepted risk: API-key holder can mint UI pairing codes; sessions memory-only"
       },
       "fullDescription": {
        "text": "Same-user tool. Key file 0600, codes single-use, 120 s TTL."
       },
       "defaultConfiguration": {
        "level": "note"
       }
      },
      {
       "id": "CG-ACC-009",
       "shortDescription": {
        "text": "Accepted risk: release .app is ad-hoc signed, not notarized"
       },
       "fullDescription": {
        "text": "Gatekeeper quarantines downloads; SHA-256 published; provenance attestation enabled when the repo is public."
       },
       "defaultConfiguration": {
        "level": "note"
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "CG-ACC-001",
     "level": "note",
     "message": {
      "text": "A signed head (audit.pb.head) detects whole-record tail deletion by anyone without audit.key. A same-user attacker holding the key can forge it; mitigation is an off-host anchor of `audit tail -n 1`."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "crates/cg-audit/src/lib.rs"
        }
       }
      }
     ],
     "properties": {
      "reachability": "n/a (design risk)",
      "fix_action": "accept-risk"
     }
    },
    {
     "ruleId": "CG-ACC-003",
     "level": "note",
     "message": {
      "text": "foldhash x2, hashbrown x3, syn x2. No advisories; binary size and build time only."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "Cargo.lock"
        }
       }
      }
     ],
     "properties": {
      "reachability": "n/a (design risk)",
      "fix_action": "accept-risk"
     }
    },
    {
     "ruleId": "CG-ACC-005",
     "level": "note",
     "message": {
      "text": "Local scan only. CI builds cargo-audit from crates.io with --locked."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/audit.yml"
        }
       }
      }
     ],
     "properties": {
      "reachability": "n/a (design risk)",
      "fix_action": "accept-risk"
     }
    },
    {
     "ruleId": "CG-ACC-006",
     "level": "note",
     "message": {
      "text": "No Developer ID / notarization; a nuisance, not a bypass."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "scripts/install.sh"
        }
       }
      }
     ],
     "properties": {
      "reachability": "n/a (design risk)",
      "fix_action": "accept-risk"
     }
    },
    {
     "ruleId": "CG-ACC-007",
     "level": "note",
     "message": {
      "text": "Resets on restart; restarting needs local access; provider spend limits are the backstop."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "crates/cg-core/src/external.rs"
        }
       }
      }
     ],
     "properties": {
      "reachability": "n/a (design risk)",
      "fix_action": "accept-risk"
     }
    },
    {
     "ruleId": "CG-ACC-008",
     "level": "note",
     "message": {
      "text": "Same-user tool. Key file 0600, codes single-use, 120 s TTL."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "crates/cg-researcher/src/serve.rs"
        }
       }
      }
     ],
     "properties": {
      "reachability": "n/a (design risk)",
      "fix_action": "accept-risk"
     }
    },
    {
     "ruleId": "CG-ACC-009",
     "level": "note",
     "message": {
      "text": "Gatekeeper quarantines downloads; SHA-256 published; provenance attestation enabled when the repo is public."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/release.yml"
        }
       }
      }
     ],
     "properties": {
      "reachability": "n/a (design risk)",
      "fix_action": "accept-risk"
     }
    }
   ]
  }
 ]
}
