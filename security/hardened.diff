# hardened.diff — baseline = minimal 'cargo new' workspace (no prior manifest existed; this is a greenfield port).
# 0 vulnerable crates were found, so no version bumps are needed. The diff shows hardening only: lints, release profile, MSRV, deny policy.
diff --git a/Cargo.toml b/Cargo.toml
index ea743bd..9799498 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,3 +1,23 @@
 [workspace]
 resolver = "3"
 members = ["crates/*"]
+
+[workspace.package]
+version = "0.1.0"
+edition = "2024"
+rust-version = "1.90"
+license = "MIT"
+repository = "https://github.com/cgfixit/cg-researcher"
+
+[workspace.lints.rust]
+unsafe_code = "forbid"
+
+[workspace.lints.clippy]
+unwrap_used = "warn"
+dbg_macro = "deny"
+
+[profile.release]
+lto = "thin"
+codegen-units = 1
+strip = "symbols"
+panic = "abort"
diff --git a/deny.toml b/deny.toml
new file mode 100644
index 0000000..e481fe7
--- /dev/null
+++ b/deny.toml
@@ -0,0 +1,30 @@
+[graph]
+all-features = false
+
+[advisories]
+version = 2
+yanked = "deny"
+ignore = []
+
+[licenses]
+version = 2
+allow = ["MIT", "Apache-2.0", "Apache-2.0 WITH LLVM-exception", "BSD-3-Clause", "ISC", "Unicode-3.0", "Zlib", "CDLA-Permissive-2.0", "MPL-2.0", "BSL-1.0"]
+confidence-threshold = 0.9
+
+[bans]
+multiple-versions = "warn"
+wildcards = "deny"
+# Telemetry / remote-reporting SDKs are banned outright (I2).
+deny = [
+  { name = "opentelemetry" },
+  { name = "opentelemetry-otlp" },
+  { name = "sentry" },
+  { name = "posthog-rs" },
+  { name = "openssl-sys" },
+  { name = "native-tls" },
+]
+
+[sources]
+unknown-registry = "deny"
+unknown-git = "deny"
+allow-registry = ["https://github.com/rust-lang/crates.io-index"]
diff --git a/rust-toolchain.toml b/rust-toolchain.toml
new file mode 100644
index 0000000..955e964
--- /dev/null
+++ b/rust-toolchain.toml
@@ -0,0 +1,4 @@
+[toolchain]
+channel = "1.99.1"
+components = ["rustfmt", "clippy"]
+profile = "minimal"
